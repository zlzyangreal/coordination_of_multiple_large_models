{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewResult",
  "type": "object",
  "required": ["request_id", "artifact_hash", "artifact_mtime", "pages_seen", "title_confirmed", "findings", "confidence"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "artifact_mtime": {"type": "string", "minLength": 1},
    "pages_seen": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
    "title_confirmed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "title"],
        "properties": {
          "page": {"type": "integer"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "element", "severity", "severity_basis", "issue", "evidence", "fix", "origin"],
        "properties": {
          "id": {"type": "string"},
          "page": {"type": "integer"},
          "element": {"type": "string", "minLength": 1},
          "severity": {"enum": ["high", "medium", "low", "notice"]},
          "severity_basis": {"type": "string", "minLength": 1},
          "issue": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "fix": {"type": "string", "minLength": 1},
          "origin": {
            "enum": ["independent", "advisory-derived"],
            "description": "independent = reviewer found it on its own; advisory-derived = the reviewed text came from this same model's earlier draft, so this chapter is not independently reviewed"
          }
        }
      }
    },
    "challenges": {
      "type": "array",
      "description": "Re-open a closed item only with new evidence",
      "items": {
        "type": "object",
        "required": ["id", "reason", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
